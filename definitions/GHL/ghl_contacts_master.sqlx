contacts AS (
  SELECT
    id AS contactId,
    dnd,
    city,
    type,
    email,
    state,
    source,
    country,
    firstName,
    lastName,
    timezone,
    DATETIME(TIMESTAMP(dateAdded), "America/New_York") AS dateAdded_est,
    DATETIME(TIMESTAMP(dateUpdated), "America/New_York") AS dateUpdated_est,
    dateAdded,
    dateUpdated,
    assignedTo,
    locationId,
    postalCode,
    companyName,
    contactName,
    firstNameRaw,
    lastNameRaw,
    profilePhoto
  FROM relentless_ghl.Contacts
)
 
SELECT *
FROM contacts
LEFT JOIN first_attribution USING (contactId)
LEFT JOIN last_attribution USING (contactId)
-- LEFT JOIN tags_flattened USING (contactId)
