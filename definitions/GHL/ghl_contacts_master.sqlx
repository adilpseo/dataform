WITH first_attribution AS (
  SELECT
    contactId,
    utmSource AS first_attribution_utmSource,
    utmMedium AS first_attribution_utmMedium,
    utmContent AS first_attribution_utmContent,
    medium AS first_attribution_medium,
    utmSessionSource AS first_attribution_utmSessionSource
  FROM ${ref('ghl_contact_attributions')}
  WHERE isFirst = 'true'
),

last_attribution AS (
  SELECT
    contactId,
    utmSource AS last_attribution_utmSource,
    utmMedium AS last_attribution_utmMedium,
    utmContent AS last_attribution_utmContent,
    medium AS last_attribution_medium,
    utmSessionSource AS last_attribution_utmSessionSource
  FROM ${ref('ghl_contact_attributions')}
  WHERE isLast = 'true'
),

