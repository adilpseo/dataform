config {
  type: "table",
  tags: ["daily"]
}

WITH raw_forms AS (
  SELECT
    id,
    name,
    locationId,
    -- ROW_NUMBER() OVER(PARTITION BY id ORDER BY _airbyte_extracted_at DESC) rn
  FROM ghl_extract.Forms
)

SELECT 
  f.*,
  l.name AS location_name,
  l.timezone
  
FROM raw_forms f
JOIN ${ref('ghl_locations')} l ON f.locationId = l.id
-- WHERE rn = 1