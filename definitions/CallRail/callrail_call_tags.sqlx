config {
  type: "table",
  tags: ["hourly"]
}

SELECT
    id, 
    company_id,
    STRING_AGG(tag_name, ', ') AS tag_names

FROM (
    SELECT
        id,company_id,
        JSON_EXTRACT_SCALAR(tag, '$.name') AS tag_name
    FROM callrail.Calls,
    UNNEST(JSON_EXTRACT_ARRAY(tags)) AS tag
)

GROUP BY id, company_id