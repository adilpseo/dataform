config {
  type: "table",
  tags: ["hourly"]
}

WITH google_campaigns AS (
  SELECT 
      id AS campaign_id,
      customer_id,
      advertising_channel_type, 
      name AS campaign_name
  FROM google_ads.campaign_history
  WHERE _fivetran_active IS TRUE
  AND customer_id NOT IN (SELECT DISTINCT id FROM lsa_mcc.account_history)

  UNION ALL

  SELECT 
    id AS campaign_id,
    customer_id,
    advertising_channel_type, 
    name AS campaign_name
  FROM lsa_mcc.campaign_history
  WHERE _fivetran_active IS TRUE
  -- AND customer_id NOT IN (SELECT DISTINCT id FROM google_ads.account_history)
),

compaign_stats AS (
  SELECT
    date,
    customer_id,
    id AS campaign_id,
    SUM(SAFE_DIVIDE(cost_micros, 1000000)) AS ad_spend,
    SUM(clicks) AS clicks,
    SUM(impressions) AS impressions,
    SUM(conversions) AS conversions
  FROM google_ads.campaign_stats
  WHERE customer_id NOT IN (SELECT DISTINCT id FROM lsa_mcc.account_history)
  GROUP BY date, customer_id, id

  UNION ALL

  SELECT
    date,
    customer_id,
    id AS campaign_id,
    SUM(SAFE_DIVIDE(cost_micros, 1000000)) AS ad_spend,
    SUM(clicks) AS clicks,
    SUM(impressions) AS impressions,
    SUM(conversions) AS conversions
  FROM lsa_mcc.campaign_stats
  -- WHERE customer_id NOT IN (SELECT DISTINCT id FROM google_ads.account_history)
  GROUP BY date, customer_id, id
),

google_ads_spend AS (
  SELECT *
  FROM compaign_stats cs 
  JOIN google_campaigns gc USING(customer_id, campaign_id)
),

-- Count of non-LSA campaigns across ALL of the client's Google accounts for the day.
-- calls_ppc / forms_ppc are divided by this so SUM() over the campaign rows equals
-- the true daily total exactly once -- even when a client has multiple Google Ads
-- accounts. (Previously the count was per customer_id, which multi-counted the daily
-- call/form total once per account for clients with >1 Google account.)
client_campaign_count AS (
    SELECT
        gi.clientkey,
        gi.lid,
        gs.date,
        COUNT(DISTINCT CONCAT(CAST(gs.customer_id AS STRING), '-', CAST(gs.campaign_id AS STRING))) AS campaigns
    FROM google_ads_spend gs
    JOIN ${ref("google_ad_ids")} gi USING (customer_id)
    WHERE gs.advertising_channel_type != 'LOCAL_SERVICES'
    GROUP BY 1,2,3
),

daily_calls_ppc AS (
  SELECT
    clientkey,
    lid,
    DATE(created_at) AS date,
    COUNT(CASE WHEN source_attribution = 'PPC' THEN id END) AS calls_ppc,
  FROM ${ref('callrail_calls')}
  GROUP BY 1,2,3
),

daily_forms_ppc AS (
  SELECT
    clientkey,
    lid,
    DATE(submitted_at) AS date,
    COUNT(CASE WHEN form_source_category = 'PPC' THEN submission_id END) AS forms_ppc
  FROM ${ref('ghl_form_submissions')}
  GROUP BY 1,2,3
)

SELECT 
   * EXCEPT(campaigns, calls_ppc, forms_ppc),

   CASE 
    WHEN advertising_channel_type = 'LOCAL_SERVICES' THEN 'LSA Spend'
    ELSE 'Google Ads Spend'
   END AS spend_type,

   CASE WHEN advertising_channel_type != 'LOCAL_SERVICES' THEN SAFE_DIVIDE(calls_ppc, campaigns) END AS calls_ppc,
   CASE WHEN advertising_channel_type != 'LOCAL_SERVICES' THEN SAFE_DIVIDE(forms_ppc, campaigns) END AS forms_ppc,


FROM google_ads_spend AS gads
LEFT JOIN ${ref("google_ad_ids")} c USING(customer_id)
LEFT JOIN ${ref('google_ads_impressions')} i USING (campaign_id, date)

LEFT JOIN client_campaign_count cc USING(clientkey, lid, date)
LEFT JOIN daily_calls_ppc dcp USING(clientkey, lid, date)
LEFT JOIN daily_forms_ppc dcf USING(clientkey, lid, date)

